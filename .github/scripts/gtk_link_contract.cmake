cmake_minimum_required(VERSION 3.18)
if(NOT EXISTS "${DETECTION_FILE}")
  message(FATAL_ERROR "An actual detect_gtk.cmake source file is required")
endif()
set(WITH_GTK ON)
set(WITH_GTK_2_X OFF)
set(WITH_OPENGL OFF)
set(GTK3_INCLUDE_DIRS "/usr/include/gtk-3.0")
set(INPUT_LIBRARIES "gtk-3;gdk-3;pangocairo-1.0;pango-1.0;harfbuzz;libharfbuzz.so;/usr/lib/libharfbuzz.so.0.60830.0;/usr/lib/libharfbuzz.a;harfbuzz-subset;cairo;gobject-2.0;glib-2.0")
macro(ocv_clear_vars)
  foreach(name ${ARGN})
    unset(${name})
  endforeach()
endmacro()
macro(ocv_check_modules name)
  set(HAVE_${name} TRUE)
  set(${name}_LIBRARIES "${INPUT_LIBRARIES}")
endmacro()
macro(ocv_add_external_target name include_dirs libraries definitions)
  if("${name}" STREQUAL "gtk3")
    set(CAPTURED_LIBRARIES "${libraries}")
  endif()
endmacro()
set(HARFBUZZ_IS_BUNDLED YES)
include("${DETECTION_FILE}")
set(EXPECTED_BUNDLED "gtk-3;gdk-3;pangocairo-1.0;pango-1.0;harfbuzz-subset;cairo;gobject-2.0;glib-2.0")
if(NOT "${CAPTURED_LIBRARIES}" STREQUAL "${EXPECTED_BUNDLED}")
  message(FATAL_ERROR "Bundled HarfBuzz dependency list mismatch: ${CAPTURED_LIBRARIES}")
endif()
set(HARFBUZZ_IS_BUNDLED NO)
include("${DETECTION_FILE}")
if(NOT "${CAPTURED_LIBRARIES}" STREQUAL "${INPUT_LIBRARIES}")
  message(FATAL_ERROR "System-only HarfBuzz dependencies were changed")
endif()
message(STATUS "PASS: actual GTK detection retains all non-HarfBuzz dependencies and system-only behavior")
