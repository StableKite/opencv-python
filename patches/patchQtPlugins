diff --git a/opencv/CMakeLists.txt b/opencv/CMakeLists.txt
--- a/opencv/CMakeLists.txt
+++ b/opencv/CMakeLists.txt
@@ -1404,6 +1404,38 @@
 if(WITH_QT OR HAVE_QT)
   if(HAVE_QT)
     status("    QT:" "YES (ver ${QT_VERSION_MAJOR}.${QT_VERSION_MINOR}.${QT_VERSION_PATCH} ${QT_EDITION})")
+    if(APPLE)
+      install(DIRECTORY ${Qt5_DIR}/../../../plugins DESTINATION lib/qt)
+    endif()
+    if(UNIX AND NOT APPLE)
+      set(_sk_qmake "")
+      if(TARGET Qt${QT_VERSION_MAJOR}::qmake)
+        get_target_property(_sk_qmake Qt${QT_VERSION_MAJOR}::qmake IMPORTED_LOCATION)
+      endif()
+      if(NOT _sk_qmake)
+        unset(_sk_qmake)
+        if(QT_VERSION_MAJOR EQUAL 5)
+          find_program(_sk_qmake NAMES qmake-qt5 qmake)
+        else()
+          find_program(_sk_qmake NAMES qmake6 qmake)
+        endif()
+      endif()
+      if(NOT _sk_qmake)
+        message(FATAL_ERROR "Qt qmake not found for the selected Qt build")
+      endif()
+      execute_process(COMMAND "${_sk_qmake}" -query QT_VERSION
+        RESULT_VARIABLE _sk_version_rc OUTPUT_VARIABLE _sk_version OUTPUT_STRIP_TRAILING_WHITESPACE)
+      if(NOT _sk_version_rc EQUAL 0 OR NOT _sk_version VERSION_EQUAL "${QT_VERSION_MAJOR}.${QT_VERSION_MINOR}.${QT_VERSION_PATCH}")
+        message(FATAL_ERROR "Qt qmake version mismatch: ${_sk_version}")
+      endif()
+      execute_process(COMMAND "${_sk_qmake}" -query QT_INSTALL_PLUGINS
+        RESULT_VARIABLE _sk_plugin_rc OUTPUT_VARIABLE _sk_qt_plugin_dir OUTPUT_STRIP_TRAILING_WHITESPACE)
+      if(NOT _sk_plugin_rc EQUAL 0 OR NOT EXISTS "${_sk_qt_plugin_dir}/platforms/libqxcb.so")
+        message(FATAL_ERROR "Selected Qt has no xcb plugin: ${_sk_qt_plugin_dir}")
+      endif()
+      install(DIRECTORY "${_sk_qt_plugin_dir}" DESTINATION lib/qt)
+      install(DIRECTORY /usr/share/fonts DESTINATION lib/qt)
+    endif()
     if(HAVE_QT_OPENGL)
       if(Qt${QT_VERSION_MAJOR}OpenGL_LIBRARIES)
         status("      QT OpenGL support:" HAVE_QT_OPENGL THEN "YES (${Qt${QT_VERSION_MAJOR}OpenGL_LIBRARIES} ${Qt${QT_VERSION_MAJOR}OpenGL_VERSION_STRING})" ELSE NO)
